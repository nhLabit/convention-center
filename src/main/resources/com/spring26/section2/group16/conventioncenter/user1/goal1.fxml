<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.spring26.section2.group16.conventioncenter.user1.Goal1Controller">
    <children>
        <Button layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#returnToDashboardOnClick" text="&lt; Back to Dashboard" textFill="#2f579a" />

        <Text fill="#d43030" layoutX="188.0" layoutY="54.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Manage New Leads">
            <font>
                <Font size="26.0" />
            </font>
        </Text>

        <Text layoutX="120.0" layoutY="120.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Client Name:" />
        <TextField fx:id="clientNameField" layoutX="230.0" layoutY="103.0" prefWidth="200.0" />

        <Text layoutX="120.0" layoutY="165.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Phone Number:" />
        <TextField fx:id="phoneField" layoutX="230.0" layoutY="148.0" prefWidth="200.0" />

        <Text layoutX="120.0" layoutY="210.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Estimated Guests:" />
        <TextField fx:id="guestsField" layoutX="230.0" layoutY="193.0" prefWidth="200.0" />

        <Button layoutX="268.0" layoutY="250.0" mnemonicParsing="false" onAction="#saveLeadOnClick" prefHeight="35.0" prefWidth="125.0" text="Save Lead" textFill="#207c2a">
            <font>
                <Font size="14.0" />
            </font>
        </Button>

        <Label fx:id="statusLabel" layoutX="120.0" layoutY="310.0" prefHeight="20.0" prefWidth="400.0" textFill="#d43030" alignment="CENTER" />
    </children>
</AnchorPane>
