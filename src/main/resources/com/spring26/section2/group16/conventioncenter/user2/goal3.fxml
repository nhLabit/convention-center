<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.spring26.section2.group16.conventioncenter.user2.Goal3Controller">
    <children>
        <Button layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#returnToDashboardOnClick" text="&lt; Back to Dashboard" textFill="#2f579a" />
        <Text fill="#d43030" layoutX="200.0" layoutY="54.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Issue Badges">
            <font><Font size="26.0" /></font>
        </Text>

        <Text layoutX="120.0" layoutY="120.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Visitor Name:" />
        <TextField fx:id="visitorNameField" layoutX="230.0" layoutY="103.0" prefWidth="200.0" />

        <Button layoutX="250.0" layoutY="160.0" mnemonicParsing="false" onAction="#generateBadgeOnClick" prefHeight="35.0" prefWidth="125.0" text="Print Badge" textFill="#207c2a" />
//
        <Label fx:id="badgeStatusLabel" alignment="CENTER" layoutX="100.0" layoutY="220.0" prefHeight="80.0" prefWidth="400.0" text="..." style="-fx-border-color: black; -fx-background-color: #f0f0f0;" />
    </children>
</AnchorPane>
