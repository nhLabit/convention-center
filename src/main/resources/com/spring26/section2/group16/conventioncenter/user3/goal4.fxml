<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.spring26.section2.group16.conventioncenter.user3.Goal4Controller">

   <children>

      <!-- Form Container -->
      <VBox layoutX="12.0" layoutY="55.0" prefHeight="281.0" prefWidth="488.0" spacing="15">

         <!-- Username -->
         <HBox spacing="10">
            <Label prefWidth="100" text="Username:" />
            <TextField fx:id="userNameField" prefWidth="200" />
         </HBox>

         <!-- Password -->
         <HBox spacing="10">
            <Label prefWidth="100" text="Password:" />
            <PasswordField fx:id="passwordField" prefWidth="200" />
         </HBox>

         <!-- Role -->
         <HBox spacing="10">
            <Label prefWidth="100" text="Role:" />
            <ComboBox fx:id="roleComboBox" prefWidth="200" promptText="Select Role" />
         </HBox>
         <Button alignment="CENTER" mnemonicParsing="false" onAction="#addUserOnClick" text="Add User" />
         <Label fx:id="labelL" prefHeight="68.0" prefWidth="470.0" text="Label" />
         <Button mnemonicParsing="false" onAction="#dashboardOnClick" text="Dashboard" />

      </VBox>
      <Label layoutX="165.0" layoutY="7.0" text="Add New User" textFill="#e40e0e">
         <font>
            <Font size="18.0" />
         </font>
      </Label>

   </children>
</AnchorPane>
